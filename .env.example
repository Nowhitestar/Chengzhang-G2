# Copy to .env. With nothing set, the backend runs in demo mode: the AI is
# simulated, so the whole flow can be tried in the simulator without any key.

# One OpenRouter key covers both: transcription (Qwen ASR) and writing (Claude).
OPENROUTER_API_KEY=

# Optional: talk to Anthropic directly for writing. Transcription still needs
# OPENROUTER_API_KEY, or DashScope below.
# ANTHROPIC_API_KEY=

# Optional: models. The defaults are Claude Opus 5.5 for writing and
# Claude Sonnet 5.5 for the fact check.
# LLM_MODEL=anthropic/claude-opus-5.5
# RESEARCH_MODEL=anthropic/claude-sonnet-5.5
# How many web searches the fact check may run per article. 0 turns it off.
# RESEARCH_SEARCHES=4

# Optional: transcription through Alibaba Cloud Model Studio instead of OpenRouter.
# STT_PROVIDER=dashscope
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# A workspace key (it starts with "sk-ws-") only works on that workspace's own
# endpoint, shown in the Model Studio console; put that address here, ending in /compatible-mode/v1.
# STT_MODEL=qwen3-asr-flash
# A language hint for transcription ("en", "zh"…). Leave unset to let the model decide.
# STT_LANGUAGE=

# Recommended on any server other people can reach: a code each new device must
# enter once (on the phone) before it can use this backend.
# ACCESS_CODE=

# Optional: "Send to Notion". An internal integration token, and the page that
# new articles are created under (share that page with the integration).
# NOTION_TOKEN=
# NOTION_PARENT_PAGE_ID=

# Optional: daily ceilings per device.
# MAX_AUDIO_MINUTES_PER_DAY=60
# MAX_COMPOSES_PER_DAY=20
# MAX_EDITS_PER_DAY=60

# PORT=8787
# DATA_DIR=data
# Force demo mode even when keys are set (MOCK_LLM=1 / MOCK_STT=1 simulate just one side).
# MOCK_AI=1
# How long each simulated step takes, and per-step exceptions (tidy, research, write, edit, answer).
# MOCK_DELAY_MS=1200
# MOCK_DELAYS=tidy=900,edit=1500
