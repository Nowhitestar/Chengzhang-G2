{
  "name": "chengzhang-g2",
  "version": "0.1.0",
  "private": true,
  "description": "Chengzhang for Even Realities G2: talk an article into existence, then decide on the AI's additions with a tap.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,app -c gray,green \"npm:dev:server\" \"npm:dev:app\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:app": "vite",
    "sim": "evenhub-simulator http://localhost:5173",
    "build": "tsc --noEmit && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "e2e": "tsx scripts/e2e.ts",
    "pack": "tsx scripts/pack.ts",
    "qr": "evenhub qr"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@evenrealities/pretext": "^0.1.4",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.21",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^22.0.0",
    "concurrently": "^10.0.7",
    "typescript": "^5.6.0",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.13"
  }
}
